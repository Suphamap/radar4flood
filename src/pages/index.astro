---
import Layout from '../layouts/Layout.astro';

const forecastUrl = import.meta.env.PUBLIC_FORECAST_URL || '/radar4flood';

const navItems = [
	{ label: 'Home', href: '/' },
	{ label: 'Radar4Flood', href: '/radar4flood' },
	{ label: 'News', href: '/news' },
	{ label: 'Publication', href: '/publication' },
	{ label: 'Staff', href: '/staff' },
	{ label: 'Contact Us', href: '/contact' },
];

const projectSignals = [
	{
		label: 'Project focus',
		value: 'Radar rainfall',
		detail: 'ข้อมูลเรดาร์อากาศสำหรับงานคาดการณ์น้ำท่วม',
	},
	{
		label: 'Content flow',
		value: 'News + field work',
		detail: 'ข่าว กิจกรรม และภาพการทำงานภาคสนาม',
	},
	{
		label: 'Academic output',
		value: 'Publication records',
		detail: 'บทความ รายงาน และเอกสารประกอบโครงการ',
	},
];

const newsItems = [
	{
		category: 'Work Update',
		title: 'ติดตามสถานีเรดาร์และจุดตรวจวัดระดับน้ำในพื้นที่ศึกษา',
		excerpt:
			'ทีมโครงการรวบรวมข้อมูลภาคสนามเพื่อสนับสนุนการประเมินฝนจากเรดาร์และการสื่อสารความเสี่ยงน้ำท่วม',
		date: '20 พ.ค. 2568',
		href: '/news',
		featured: true,
	},
	{
		category: 'Project Milestone',
		title: 'เตรียมโครงสร้างข้อมูลข่าวสำหรับ Sanity CMS',
		excerpt: 'ข่าว กิจกรรม และภาพภาคสนามจะจัดการผ่านเอกสารสองภาษาในระบบ CMS',
		date: '12 พ.ค. 2568',
		href: '/news',
	},
	{
		category: 'Publication',
		title: 'จัดรูปแบบรายการผลงานวิชาการให้ค้นหาและอ่านง่าย',
		excerpt: 'รองรับชื่อบทความ ผู้แต่ง ปี วารสาร DOI และไฟล์ประกอบเมื่อข้อมูลพร้อม',
		date: '5 พ.ค. 2568',
		href: '/publication',
	},
];

const publicationItems = [
	{
		type: 'Journal Article',
		title: 'Radar rainfall estimation for flood forecasting',
		detail: 'โครงสร้างสำหรับบทความวารสาร พร้อมปี ผู้แต่ง วารสาร และ DOI',
	},
	{
		type: 'Conference Paper',
		title: 'Weather radar data for operational hydrology',
		detail: 'รองรับรายการประชุมวิชาการ บทคัดย่อ และลิงก์ไฟล์นำเสนอ',
	},
	{
		type: 'Project Report',
		title: 'Flood monitoring field report',
		detail: 'พื้นที่สำหรับรายงานโครงการ ข้อมูลภาคสนาม และเอกสารอ้างอิง',
	},
];
---

<Layout
	title="Radar4Flood | ระบบเรดาร์เพื่อการคาดการณ์น้ำท่วม"
	description="Radar4Flood introduces a radar-based flood forecasting academic project, with project updates, publications, staff information, and a path to the forecast webpage."
>
	<header class="sticky inset-x-0 top-0 z-30 bg-r4f-navy text-white">
		<nav
			class="mx-auto flex max-w-[94rem] items-center justify-between gap-5 px-5 py-3.5 sm:px-8 2xl:max-w-[102rem]"
			aria-label="Primary navigation"
		>
			<a class="flex min-h-11 items-center" href="/" aria-label="Radar4Flood Home">
				<img
					class="h-11 w-auto object-contain sm:h-12"
					src="/images/Radar4flood_Horizon_PNG.png"
					alt="โลโก้ของโครงการ Radar4Flood"
					width="192"
					height="32"
				/>
			</a>

			<div class="hidden items-center gap-1 rounded-full bg-white/8 px-2 py-1.5 lg:flex">
				{
					navItems.map((item) => (
						<a
							class="rounded-full px-3.5 py-2 text-sm font-medium text-white/78 transition hover:bg-white/12 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
							href={item.href}
						>
							{item.label}
						</a>
					))
				}
			</div>

			<a
				class="hidden min-h-11 items-center rounded-full px-4 text-sm font-semibold text-white/82 transition hover:bg-white hover:text-r4f-navy focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white lg:inline-flex"
				href="/en"
			>
				EN
			</a>

			<details class="relative lg:hidden">
				<summary
					class="list-none rounded-full bg-white px-4 py-2.5 text-sm font-semibold text-r4f-navy marker:hidden"
				>
					เมนู
				</summary>
				<div class="absolute right-0 mt-3 w-60 rounded-2xl bg-white p-2 text-r4f-navy shadow-[0_8px_24px_rgb(0_30_69_/_18%)]">
					{
						navItems.map((item) => (
							<a class="block rounded-xl px-4 py-3 text-sm font-semibold hover:bg-r4f-low" href={item.href}>
								{item.label}
							</a>
						))
					}
					<a class="block rounded-xl px-4 py-3 text-sm font-semibold hover:bg-r4f-low" href="/en">
						EN
					</a>
				</div>
			</details>
		</nav>
	</header>

	<main>
		<section class="radar-field relative isolate overflow-hidden text-white">
			<div class="hero-shell mx-auto grid max-w-[94rem] gap-9 px-5 pb-10 pt-14 sm:px-8 md:pb-14 md:pt-20 xl:grid-cols-[minmax(0,0.82fr)_minmax(32rem,1fr)] xl:items-end xl:gap-12 xl:pb-0 xl:pt-24 2xl:max-w-[102rem]">
				<div class="relative z-10 max-w-2xl pb-1 xl:pb-16">
					<p class="inline-flex rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-sky-100">
						ระบบเรดาร์เพื่อการคาดการณ์น้ำท่วม
					</p>
					<h1 class="mt-5 max-w-3xl font-display text-[clamp(3rem,8vw,5.75rem)] font-semibold leading-[1.04] tracking-normal">
						Radar4Flood
					</h1>
					<p class="mt-6 max-w-2xl text-xl font-medium leading-9 text-white sm:text-2xl">
						เชื่อมโยงข้อมูลเรดาร์อากาศ งานภาคสนาม และงานวิชาการ เพื่อสื่อสารการคาดการณ์น้ำท่วมอย่างชัดเจน
					</p>
					<p class="mt-5 max-w-xl text-base leading-8 text-white/76">
						เว็บไซต์สาธารณะสำหรับแนะนำโครงการ เผยแพร่ข่าวและกิจกรรม แสดงผลงานวิชาการ และนำผู้ใช้งานไปยังหน้า forecast ที่มีอยู่แล้ว
					</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a
							class="inline-flex min-h-11 items-center rounded-full bg-white px-5 py-3 text-sm font-bold text-r4f-navy transition hover:bg-sky-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
							href={forecastUrl}
						>
							เข้าสู่หน้าพยากรณ์
						</a>
						<a
							class="inline-flex min-h-11 items-center rounded-full bg-r4f-teal px-5 py-3 text-sm font-bold text-white transition hover:bg-[#086065] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
							href="/news"
						>
							อ่านข่าวล่าสุด
						</a>
					</div>
				</div>

				<figure class="hero-media relative z-10 -mx-5 aspect-[1.16/1] overflow-hidden rounded-2xl bg-r4f-navy sm:mx-0 md:aspect-[1.36/1] xl:w-[min(53vw,53rem)] xl:max-w-none xl:justify-self-end xl:aspect-[1.18/1]">
					<img
						class="hero-image h-full w-full object-cover object-center"
						src="/images/radar4flood-field-radar.png"
						alt="สถานีเรดาร์ใกล้พื้นที่น้ำและทีมงานภาคสนามของโครงการ Radar4Flood"
						width="1824"
						height="863"
						loading="eager"
						fetchpriority="high"
					/>
					<div class="absolute inset-x-0 bottom-0 h-44 bg-gradient-to-t from-r4f-navy/82 via-r4f-navy/24 to-transparent"></div>
					<div
						class="signal-sweep absolute right-[9%] top-[15%] h-48 w-48 rounded-full border border-sky-200/30 bg-sky-200/8 sm:h-56 sm:w-56"
						aria-hidden="true"
					></div>
					<figcaption class="absolute bottom-5 left-5 max-w-sm rounded-xl bg-[rgb(0_30_69_/_84%)] px-4 py-3 text-sm leading-6 text-white/84 backdrop-blur">
						ภาพประกอบสำหรับสื่อสารงานเรดาร์และการตรวจวัดภาคสนาม
					</figcaption>
				</figure>
			</div>
		</section>

		<section class="bg-r4f-low">
			<div class="mx-auto grid max-w-[94rem] gap-8 px-5 py-10 sm:px-8 lg:grid-cols-[0.7fr_1fr] lg:items-start 2xl:max-w-[102rem]">
				<div>
					<p class="font-display text-3xl font-semibold leading-tight text-r4f-navy">
						เว็บไซต์โครงการ ไม่ใช่หน้าจอ forecast
					</p>
					<p class="mt-4 max-w-xl text-base leading-8 text-r4f-muted">
						หน้าเว็บนี้จัดระเบียบข้อมูลสาธารณะของโครงการ ส่วนระบบพยากรณ์จะเปิดผ่านหน้า Radar4Flood โดยตรง
					</p>
				</div>

				<div class="grid gap-4 md:grid-cols-3">
					{
						projectSignals.map((item) => (
							<div class="rounded-2xl bg-white px-5 py-5">
								<p class="text-xs font-bold text-r4f-teal">{item.label}</p>
								<p class="mt-3 font-display text-xl font-semibold leading-tight text-r4f-navy">
									{item.value}
								</p>
								<p class="mt-3 text-sm leading-7 text-r4f-muted">{item.detail}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section id="news" class="mx-auto max-w-[94rem] px-5 py-16 sm:px-8 lg:py-24 2xl:max-w-[102rem]">
			<div class="grid gap-7 md:grid-cols-[0.72fr_1fr] md:items-end">
				<div>
					<p class="text-sm font-semibold text-r4f-teal">News</p>
					<h2 class="mt-3 font-display text-[clamp(2.25rem,5vw,4.5rem)] font-semibold leading-[1.12] tracking-normal text-r4f-navy">
						ข่าวและความก้าวหน้า
					</h2>
				</div>
				<div class="max-w-3xl md:justify-self-end">
					<p class="text-base leading-8 text-r4f-muted">
						พื้นที่สำหรับประกาศ กิจกรรมภาคสนาม การประชุม ความร่วมมือ และหลักฐานความต่อเนื่องของงานวิจัย
					</p>
					<a class="mt-5 inline-flex font-bold text-r4f-teal hover:text-r4f-navy" href="/news">
						ดูข่าวทั้งหมด
					</a>
				</div>
			</div>

			<div class="mt-11 grid gap-5 lg:grid-cols-[minmax(0,1.18fr)_minmax(20rem,0.82fr)]">
				{
					newsItems.map((item, index) => (
						<article
							class:list={[
								'transition duration-200 hover:-translate-y-0.5',
								index === 0
									? 'min-h-[27rem] rounded-2xl bg-[linear-gradient(180deg,_rgb(0_30_69_/_4%)_0%,_rgb(0_30_69_/_88%)_100%),url(/images/radar4flood-field-radar.png)] bg-cover bg-center p-6 text-white sm:p-8 lg:row-span-2'
									: 'rounded-2xl bg-r4f-low p-6 sm:p-7',
							]}
						>
							<div class:list={[index === 0 ? 'flex h-full max-w-2xl flex-col justify-end' : 'max-w-xl']}>
								<div class="mb-5 flex flex-wrap items-center gap-3">
									<span
										class:list={[
											'inline-flex rounded-full px-3 py-1 text-xs font-bold',
											index === 0 ? 'bg-white text-r4f-navy' : 'bg-white text-r4f-teal',
										]}
									>
										{item.category}
									</span>
									<span class:list={['text-sm font-medium', index === 0 ? 'text-white/76' : 'text-r4f-muted']}>
										{item.date}
									</span>
								</div>
								<h3 class:list={['font-display font-semibold leading-tight', index === 0 ? 'text-3xl sm:text-4xl' : 'text-2xl text-r4f-navy']}>
									<a class="focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-r4f-sky" href={item.href}>
										{item.title}
									</a>
								</h3>
								<p class:list={['mt-4 leading-7', index === 0 ? 'text-white/80' : 'text-r4f-muted']}>
									{item.excerpt}
								</p>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section id="publication" class="bg-r4f-low py-16 lg:py-24">
			<div class="mx-auto max-w-[94rem] px-5 sm:px-8 2xl:max-w-[102rem]">
				<div class="grid gap-8 lg:grid-cols-[0.62fr_1fr] lg:items-start">
					<div class="lg:sticky lg:top-28">
						<p class="text-sm font-semibold text-r4f-teal">ผลงานวิชาการ</p>
						<h2 class="mt-3 font-display text-[clamp(2.25rem,5vw,4.25rem)] font-semibold leading-[1.12] tracking-normal text-r4f-navy">
							ผลงานและเอกสารวิชาการ
						</h2>
						<p class="mt-5 max-w-xl text-base leading-8 text-r4f-muted">
							บทความวารสาร รายงานการประชุม และเอกสารโครงการจากทีมวิจัย Radar4Flood
						</p>
						<a
							class="mt-7 inline-flex min-h-11 items-center rounded-full bg-r4f-teal px-5 py-3 text-sm font-bold text-white transition hover:bg-[#086065] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-r4f-teal"
							href="/publication"
						>
							ดูผลงานวิชาการทั้งหมด
						</a>
					</div>

					<div class="grid gap-4">
						{
							publicationItems.map((item) => (
								<article class="grid gap-4 rounded-2xl bg-white p-6 sm:grid-cols-[12rem_1fr] sm:p-7">
									<span class="h-fit w-fit rounded-full bg-sky-100 px-3 py-1 text-xs font-bold text-r4f-navy">
										{item.type}
									</span>
									<div>
										<h3 class="font-display text-2xl font-semibold leading-snug text-r4f-navy">
											{item.title}
										</h3>
										<p class="mt-3 text-sm leading-7 text-r4f-muted">{item.detail}</p>
									</div>
								</article>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-[94rem] px-5 py-16 sm:px-8 lg:py-20 2xl:max-w-[102rem]">
			<div class="grid gap-8 rounded-2xl bg-r4f-navy px-6 py-8 text-white sm:px-8 md:grid-cols-[1fr_auto] md:items-center lg:px-10 lg:py-10">
				<div>
					<p class="font-display text-3xl font-semibold leading-tight">ทางเข้าระบบ Radar4Flood</p>
					<p class="mt-4 max-w-3xl text-base leading-8 text-white/74">
						อ่านภาพรวมของระบบและเปิดหน้า forecast ที่มีอยู่แล้ว โดยไม่ปะปนกับเนื้อหาข่าวและเอกสารของเว็บไซต์หลัก
					</p>
				</div>
				<a
					class="inline-flex min-h-11 w-fit items-center rounded-full bg-white px-5 py-3 text-sm font-bold text-r4f-navy transition hover:bg-sky-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
					href="/radar4flood"
				>
					ดูรายละเอียด Radar4Flood
				</a>
			</div>
		</section>
	</main>

	<footer class="bg-r4f-navy text-white">
		<div class="mx-auto grid max-w-[94rem] gap-8 px-5 py-10 sm:px-8 md:grid-cols-[1fr_auto] md:items-center 2xl:max-w-[102rem]">
			<div>
				<p class="font-display text-2xl font-semibold">Radar4Flood</p>
				<p class="mt-2 max-w-2xl text-sm leading-7 text-white/68">
					โครงการวิจัยภายใต้ความร่วมมือทางวิชาการด้านเรดาร์อากาศและอุทกวิทยา
				</p>
			</div>
			<div class="flex flex-wrap gap-3 text-sm font-semibold text-white/76">
				<a class="hover:text-white" href="/staff">Staff</a>
				<a class="hover:text-white" href="/contact">Contact Us</a>
				<a class="hover:text-white" href="/en">English</a>
			</div>
		</div>
	</footer>
</Layout>
