---
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../sections/HeroSection.astro';
import SignalsSection from '../sections/SignalsSection.astro';
import NewsPreview from '../sections/NewsPreview.astro';
import PublicationPreview from '../sections/PublicationPreview.astro';
import ForecastCTA from '../sections/ForecastCTA.astro';
import { t } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';

interface Props {
	lang?: Lang;
}

const { lang = 'th' } = Astro.props;
---

<Layout title={t(lang, 'homeMetaTitle')} description={t(lang, 'homeMetaDescription')} lang={lang}>
	<HeroSection lang={lang} />
	<SignalsSection lang={lang} />
	<NewsPreview lang={lang} />
	<PublicationPreview lang={lang} />
	<ForecastCTA lang={lang} />
</Layout>

<script>
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!prefersReducedMotion && 'IntersectionObserver' in window) {
		document.documentElement.classList.add('home-motion');

		const homeRevealObserver = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-in');
						homeRevealObserver.unobserve(entry.target);
					}
				}
			},
			{ threshold: 0.12, rootMargin: '0px 0px -7% 0px' },
		);

		document.querySelectorAll('[data-home-reveal]').forEach((element) => homeRevealObserver.observe(element));
	}
</script>

<style is:global>
	.home-motion [data-home-reveal] {
		opacity: 0;
		translate: 0 22px;
		transition:
			opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
			translate 0.7s cubic-bezier(0.22, 1, 0.36, 1);
		transition-delay: calc(var(--home-reveal-i, 0) * 85ms);
	}

	.home-motion [data-home-reveal].is-in {
		opacity: 1;
		translate: 0 0;
	}
</style>
