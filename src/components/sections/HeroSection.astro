---
import { routeHref, t } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';

interface Props {
	lang?: Lang;
}

const { lang = 'th' } = Astro.props;
---

<section class="research-hero relative isolate overflow-hidden bg-r4f-navy text-white">
	<img
		class="research-hero__image hero-boot-image absolute inset-0 h-full w-full object-cover"
		src="/images/radar4flood-field-radar.png"
		alt="สถานีเรดาร์และทีมวิจัย Radar4Flood ระหว่างการตรวจวัดข้อมูลภาคสนามในพื้นที่น้ำหลาก"
		width="1824"
		height="863"
		loading="eager"
		fetchpriority="high"
	/>
	<div class="research-hero__shade hero-boot-shade absolute inset-0" aria-hidden="true"></div>
	<span class="research-hero__scan pointer-events-none absolute inset-y-0 z-[5] w-px" aria-hidden="true"></span>

	<div
		class="research-hero__shell relative z-10 mx-auto flex max-w-[94rem] flex-col justify-end px-5 pb-10 pt-28 sm:px-8 sm:pb-12 lg:pb-16 2xl:max-w-[102rem]"
	>
		<div class="grid gap-10 xl:grid-cols-[minmax(0,1fr)_22rem] xl:items-end xl:gap-20">
			<div class="max-w-[52rem]">
				<p class="hero-boot-rise flex items-center gap-3 text-sm font-semibold text-sky-100" style="--hero-d: 0.18s;">
					<span class="hero-boot-rule h-px w-10 bg-r4f-sky" aria-hidden="true"></span>
					{t(lang, 'heroBadge')}
				</p>
				<h1
					class="hero-boot-focus mt-6 max-w-[13ch] font-display text-[clamp(3rem,6.6vw,6.25rem)] font-semibold leading-[1.03] tracking-[-0.025em]"
					style="--hero-d: 0.3s;"
				>
					{t(lang, 'heroTitle')}
				</h1>
				<p
					class="hero-boot-rise mt-7 max-w-3xl text-lg font-medium leading-9 text-white sm:text-xl sm:leading-10"
					style="--hero-d: 0.48s;"
				>
					{t(lang, 'heroSubtitle')}
				</p>
				<p class="hero-boot-rise mt-4 max-w-2xl text-base leading-8 text-white/72" style="--hero-d: 0.6s;">
					{t(lang, 'heroDescription')}
				</p>

				<div class="hero-boot-rise mt-8 flex flex-wrap items-center gap-x-6 gap-y-4" style="--hero-d: 0.72s;">
					<a
						class="inline-flex min-h-11 items-center rounded-full bg-white px-5 py-3 text-sm font-bold text-r4f-navy transition hover:bg-sky-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
						href={routeHref(lang, 'radar4flood')}
					>
						{t(lang, 'heroForecastCta')}
					</a>
					<a
						class="group inline-flex min-h-11 items-center gap-2 py-3 text-sm font-bold text-white transition hover:text-sky-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
						href={routeHref(lang, 'news')}
					>
						{t(lang, 'heroNewsCta')}
						<span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
					</a>
				</div>
			</div>

			<aside class="hero-boot-aside border-t border-white/28 pt-6 xl:border-l xl:border-t-0 xl:pb-1 xl:pl-7 xl:pt-0">
				<p class="text-xs font-bold text-sky-100">{t(lang, 'heroResearchLabel')}</p>
				<dl class="mt-5 grid gap-5 sm:grid-cols-3 xl:grid-cols-1">
					<div>
						<dt class="font-display text-lg font-semibold">{t(lang, 'heroResearchRadarTitle')}</dt>
						<dd class="mt-1 text-sm leading-6 text-white/68">{t(lang, 'heroResearchRadarDetail')}</dd>
					</div>
					<div>
						<dt class="font-display text-lg font-semibold">{t(lang, 'heroResearchFieldTitle')}</dt>
						<dd class="mt-1 text-sm leading-6 text-white/68">{t(lang, 'heroResearchFieldDetail')}</dd>
					</div>
					<div>
						<dt class="font-display text-lg font-semibold">{t(lang, 'heroResearchFloodTitle')}</dt>
						<dd class="mt-1 text-sm leading-6 text-white/68">{t(lang, 'heroResearchFloodDetail')}</dd>
					</div>
				</dl>
				<p class="mt-7 text-xs leading-6 text-white/56">{t(lang, 'heroCaption')}</p>
			</aside>
		</div>
	</div>
</section>

<style>
	.research-hero {
		min-height: clamp(44rem, calc(100svh - 4.75rem), 54rem);
	}

	.research-hero__image {
		object-position: 58% center;
		filter: saturate(0.86) contrast(1.04) brightness(0.82);
		transform: scale(1.005);
	}

	.research-hero__shade {
		background:
			linear-gradient(
				90deg,
				rgb(0 17 44 / 92%) 0%,
				rgb(0 20 51 / 79%) 38%,
				rgb(0 22 52 / 30%) 72%,
				rgb(0 22 52 / 12%) 100%
			),
			linear-gradient(0deg, rgb(0 17 44 / 94%) 0%, rgb(0 22 52 / 34%) 52%, rgb(0 22 52 / 18%) 100%);
	}

	.research-hero__shell {
		min-height: clamp(44rem, calc(100svh - 4.75rem), 54rem);
	}

	/* One orchestrated entrance, borrowing the system page's signal-sharpening motion. */
	.hero-boot-image {
		animation: home-hero-image-in 1.35s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero-boot-shade {
		animation: home-hero-shade-in 0.9s ease-out both;
	}

	.hero-boot-rise {
		animation: home-hero-rise-in 0.78s cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: var(--hero-d, 0s);
	}

	.hero-boot-focus {
		animation: home-hero-focus-in 0.95s cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: var(--hero-d, 0s);
	}

	.hero-boot-rule {
		animation: home-hero-rule-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.12s both;
		transform-origin: left;
	}

	.hero-boot-aside {
		animation: home-hero-aside-in 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.82s both;
	}

	.research-hero__scan {
		left: 42%;
		background: linear-gradient(180deg, transparent 8%, rgb(143 228 255 / 45%) 48%, transparent 92%);
		box-shadow: 0 0 24px rgb(69 160 243 / 22%);
		animation: home-hero-scan 2.2s cubic-bezier(0.22, 1, 0.36, 1) 0.38s both;
	}

	@keyframes home-hero-image-in {
		from {
			opacity: 0.55;
			filter: saturate(0.7) contrast(1.02) brightness(0.62);
			transform: scale(1.045);
		}
	}

	@keyframes home-hero-shade-in {
		from {
			opacity: 0;
		}
	}

	@keyframes home-hero-rise-in {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
	}

	@keyframes home-hero-focus-in {
		from {
			opacity: 0;
			filter: blur(11px);
			transform: translateY(0.22em);
		}
	}

	@keyframes home-hero-rule-in {
		from {
			transform: scaleX(0);
		}
	}

	@keyframes home-hero-aside-in {
		from {
			opacity: 0;
			transform: translateX(18px);
		}
	}

	@keyframes home-hero-scan {
		0% {
			opacity: 0;
			transform: translateX(-12vw);
		}
		18% {
			opacity: 0.7;
		}
		100% {
			opacity: 0;
			transform: translateX(45vw);
		}
	}

	@media (max-width: 767px) {
		.research-hero,
		.research-hero__shell {
			min-height: 49rem;
		}

		.research-hero__image {
			object-position: 68% center;
		}

		.research-hero__shade {
			background:
				linear-gradient(0deg, rgb(0 17 44 / 98%) 0%, rgb(0 21 51 / 83%) 54%, rgb(0 22 52 / 18%) 100%),
				linear-gradient(90deg, rgb(0 17 44 / 58%) 0%, rgb(0 22 52 / 12%) 100%);
		}

		.research-hero__scan {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-boot-image,
		.hero-boot-shade,
		.hero-boot-rise,
		.hero-boot-focus,
		.hero-boot-rule,
		.hero-boot-aside,
		.research-hero__scan {
			animation: none;
		}

		.research-hero__scan {
			display: none;
		}
	}
</style>
