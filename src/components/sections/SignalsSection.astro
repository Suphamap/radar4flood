---
import { t, localize } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';
import { projectSignals } from '../../data/signals';

interface Props {
	lang?: Lang;
}

const { lang = 'th' } = Astro.props;
---

<section class="bg-r4f-low">
	<div
		class="mx-auto grid max-w-[94rem] gap-10 px-5 py-12 sm:px-8 lg:grid-cols-[0.68fr_1fr] lg:items-start lg:gap-16 lg:py-16 2xl:max-w-[102rem]"
	>
		<div data-home-reveal>
			<h2 class="font-display text-3xl font-semibold leading-tight text-r4f-navy sm:text-4xl">
				{t(lang, 'signalsTitle')}
			</h2>
			<p class="mt-4 max-w-xl text-base leading-8 text-r4f-muted">
				{t(lang, 'signalsDescription')}
			</p>
		</div>

		<ol class="grid gap-8 sm:grid-cols-3 sm:gap-5">
			{
				projectSignals.map((item, index) => (
					<li class="border-t border-r4f-line pt-5" data-home-reveal style={`--home-reveal-i: ${index};`}>
						<p class="text-xs font-bold text-r4f-teal">
							{String(index + 1).padStart(2, '0')} — {item.label}
						</p>
						<p class="mt-3 font-display text-xl font-semibold leading-tight text-r4f-navy">{item.value}</p>
						<p class="mt-3 text-sm leading-7 text-r4f-muted">{localize(item.detail, lang)}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
