---
import { t, localize, routeHref } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';
import { publicationItems } from '../../data/publications';

interface Props {
	lang?: Lang;
}

const { lang = 'th' } = Astro.props;
---

<section id="publication" class="bg-r4f-low py-16 lg:py-24">
	<div class="mx-auto max-w-[94rem] px-5 sm:px-8 2xl:max-w-[102rem]">
		<div class="grid gap-8 lg:grid-cols-[0.62fr_1fr] lg:items-start">
			<div class="lg:sticky lg:top-28" data-home-reveal>
				<p class="text-sm font-semibold text-r4f-teal">{t(lang, 'pubLabel')}</p>
				<h2
					class="mt-3 font-display text-[clamp(2.25rem,5vw,4.25rem)] font-semibold leading-[1.12] tracking-normal text-r4f-navy"
				>
					{t(lang, 'pubTitle')}
				</h2>
				<p class="mt-5 max-w-xl text-base leading-8 text-r4f-muted">
					{t(lang, 'pubDescription')}
				</p>
				<a
					class="mt-7 inline-flex min-h-11 items-center rounded-full bg-r4f-teal px-5 py-3 text-sm font-bold text-white transition hover:bg-[#086065] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-r4f-teal"
					href={routeHref(lang, 'publication')}
				>
					{t(lang, 'pubViewAll')}
				</a>
			</div>

			<div class="grid gap-4">
				{
					publicationItems.map((item, index) => (
						<article
							class="grid gap-4 rounded-2xl bg-white p-6 sm:grid-cols-[12rem_1fr] sm:p-7"
							data-home-reveal
							style={`--home-reveal-i: ${index};`}
						>
							<span class="h-fit w-fit rounded-full bg-sky-100 px-3 py-1 text-xs font-bold text-r4f-navy">
								{item.type}
							</span>
							<div>
								<h3 class="font-display text-2xl font-semibold leading-snug text-r4f-navy">
									{localize(item.title, lang)}
								</h3>
								<p class="mt-3 text-sm leading-7 text-r4f-muted">{localize(item.detail, lang)}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</div>
</section>
