---
import { navItems } from '../data/navigation';
import { alternateRoutePath, routePath, t } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
import type { LabelKey } from '../lib/i18n/labels';

interface Props {
	lang?: Lang;
}

const { lang = 'th' } = Astro.props;

const langSwitchHref = alternateRoutePath(lang, Astro.url.pathname);
const langSwitchLabel = t(lang, 'navLangSwitch');

const currentPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const normalizedCurrentPath = currentPath.length > 1 ? currentPath.replace(/\/$/, '') : currentPath;

const isActiveRoute = (href: string) => {
	if (href === '/') return normalizedCurrentPath === '/';
	return normalizedCurrentPath === href || normalizedCurrentPath.startsWith(`${href}/`);
};
---

<header class="sticky inset-x-0 top-0 z-30 bg-r4f-navy text-white" data-site-header>
	<nav
		class="mx-auto flex max-w-[94rem] items-center justify-between gap-5 px-5 py-3.5 sm:px-8 lg:grid lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] 2xl:max-w-[102rem]"
		aria-label="Primary navigation"
	>
		<a
			class="flex min-h-11 items-center lg:justify-self-start"
			href={routePath(lang, '/')}
			aria-label="Radar4Flood Home"
		>
			<img
				class="h-11 w-auto object-contain sm:h-12"
				src="/images/Radar4flood_Horizon_PNG.png"
				alt="โลโก้ของโครงการ Radar4Flood"
				width="192"
				height="32"
			/>
		</a>

		<div
			class="desktop-nav relative hidden items-center gap-1 rounded-full bg-white/8 px-2 py-1.5 lg:flex"
			data-desktop-nav
		>
			<span class="desktop-signal-rail pointer-events-none absolute" aria-hidden="true">
				<span
					class="desktop-signal-point absolute left-1/2 top-1/2 size-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-r4f-sky"
				>
				</span>
			</span>
			{
				navItems.map((item) => {
					const isActive = isActiveRoute(item.href);

					return (
						<a
							class:list={[
								'desktop-nav-link relative rounded-full px-3.5 py-2 text-sm font-medium text-white/72 transition hover:bg-white/10 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white',
								{ 'font-semibold text-white': isActive },
							]}
							href={routePath(lang, item.href)}
							aria-current={isActive ? 'page' : undefined}
							data-desktop-nav-link
						>
							{t(lang, item.labelKey as LabelKey)}
						</a>
					);
				})
			}
		</div>

		<a
			class="hidden min-h-11 items-center rounded-full px-4 text-sm font-semibold text-white/82 transition hover:bg-white hover:text-r4f-navy focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white lg:inline-flex lg:justify-self-end"
			href={langSwitchHref}
		>
			{langSwitchLabel}
		</a>

		<button
			class="group inline-flex min-h-11 items-center gap-2 rounded-full bg-white/10 p-1.5 text-sm font-semibold text-white ring-1 ring-inset ring-white/20 transition hover:bg-white/16 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white lg:hidden"
			type="button"
			aria-label={t(lang, 'navMenu')}
			aria-controls="mobile-navigation"
			aria-expanded="false"
			data-mobile-menu-open
		>
			<span class="hidden pl-2 sm:inline">{t(lang, 'navMenu')}</span>
			<span class="grid size-8 place-items-center rounded-full bg-white text-r4f-navy" aria-hidden="true">
				<span class="flex w-3.5 flex-col gap-1">
					<span class="h-px w-full bg-current"></span>
					<span class="h-px w-full bg-current"></span>
				</span>
			</span>
		</button>
	</nav>

	<dialog
		id="mobile-navigation"
		class="m-0 h-[100dvh] max-h-none w-screen max-w-none border-0 bg-r4f-navy p-0 text-white lg:hidden"
		aria-label={t(lang, 'navMenu')}
		data-mobile-menu
	>
		<div class="mobile-menu-background absolute inset-0 overflow-hidden" aria-hidden="true">
			<img
				class="h-full w-full scale-[1.06] object-cover object-[68%_center]"
				src="/images/radar4flood-field-radar.png"
				alt=""
				width="1823"
				height="863"
			/>
			<div
				class="absolute inset-0 bg-[linear-gradient(105deg,rgb(0_18_45_/_96%)_0%,rgb(0_30_69_/_87%)_48%,rgb(0_30_69_/_62%)_100%)]"
			>
			</div>
			<div
				class="absolute inset-0 bg-[linear-gradient(180deg,rgb(0_30_69_/_28%)_0%,transparent_36%,rgb(0_12_32_/_86%)_100%)]"
			>
			</div>
			<div class="radar-rings absolute -right-40 top-[18%] size-[30rem] rounded-full sm:-right-24 sm:size-[38rem]">
			</div>
		</div>

		<div
			class="mobile-menu-shell relative flex h-full flex-col px-5 pb-[max(1.5rem,env(safe-area-inset-bottom))] pt-[max(.875rem,env(safe-area-inset-top))] sm:px-8"
		>
			<div class="flex items-center justify-between">
				<a class="flex min-h-11 items-center" href={routePath(lang, '/')} aria-label="Radar4Flood Home">
					<img
						class="h-11 w-auto object-contain sm:h-12"
						src="/images/Radar4flood_Horizon_PNG.png"
						alt="โลโก้ของโครงการ Radar4Flood"
						width="192"
						height="32"
					/>
				</a>

				<button
					class="grid size-11 place-items-center rounded-full bg-white text-r4f-navy transition hover:scale-105 hover:bg-r4f-low focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-r4f-sky"
					type="button"
					aria-label={t(lang, 'navClose')}
					data-mobile-menu-close
				>
					<svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<path
							d="M2.5 2.5 13.5 13.5M13.5 2.5 2.5 13.5"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"></path>
					</svg>
				</button>
			</div>

			<div class="flex min-h-0 flex-1 items-center py-5 sm:py-8">
				<div class="w-full">
					<div class="mb-3 flex items-center gap-3 text-xs font-semibold text-white/56" aria-hidden="true">
						<span class="h-px w-8 bg-r4f-sky"></span>
						<span>{t(lang, 'navMenu')}</span>
					</div>
					<nav class="flex flex-col" aria-label="Mobile navigation">
						{
							navItems.map((item, index) => {
								const isActive = isActiveRoute(item.href);

								return (
									<a
										class:list={[
											'mobile-menu-link group relative flex items-center justify-between rounded-xl px-3 py-2.5 font-display text-[clamp(1.65rem,7.8vw,3.25rem)] font-medium leading-[1.08] text-white/72 transition duration-200 hover:bg-white/10 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-r4f-sky sm:px-4 sm:py-3',
											{ 'bg-white/12 text-white': isActive },
										]}
										href={routePath(lang, item.href)}
										aria-current={isActive ? 'page' : undefined}
										style={`--item-index: ${index};`}
										data-mobile-menu-link
									>
										<span>{t(lang, item.labelKey as LabelKey)}</span>
										<span
											class:list={[
												'grid size-7 shrink-0 place-items-center rounded-full transition',
												isActive
													? 'bg-r4f-sky text-r4f-navy'
													: 'bg-white/0 text-white/0 group-hover:bg-white/12 group-hover:text-white',
											]}
											aria-hidden="true"
										>
											<svg class="size-3" viewBox="0 0 12 12" fill="none">
												<path
													d="M2 6h8M7 3l3 3-3 3"
													stroke="currentColor"
													stroke-width="1.25"
													stroke-linecap="round"
													stroke-linejoin="round"
												/>
											</svg>
										</span>
									</a>
								);
							})
						}
					</nav>
				</div>
			</div>

			<div class="flex items-center justify-between border-t border-white/16 pt-4">
				<span class="text-xs font-medium text-white/48">TH / EN</span>
				<a
					class="inline-flex min-h-11 items-center rounded-full bg-white/10 px-5 text-sm font-semibold text-white ring-1 ring-inset ring-white/16 transition hover:bg-white hover:text-r4f-navy focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-r4f-sky"
					href={langSwitchHref}
					data-mobile-menu-link
				>
					{langSwitchLabel}
				</a>
			</div>
		</div>
	</dialog>
</header>

<script>
	const siteHeader = document.querySelector<HTMLElement>('[data-site-header]');
	const menu = siteHeader?.querySelector<HTMLDialogElement>('[data-mobile-menu]');
	const openButton = siteHeader?.querySelector<HTMLButtonElement>('[data-mobile-menu-open]');
	const closeButton = siteHeader?.querySelector<HTMLButtonElement>('[data-mobile-menu-close]');
	const menuLinks = siteHeader?.querySelectorAll<HTMLAnchorElement>('[data-mobile-menu-link]');
	const desktopNav = siteHeader?.querySelector<HTMLElement>('[data-desktop-nav]');
	const desktopNavLinks = Array.from(siteHeader?.querySelectorAll<HTMLAnchorElement>('[data-desktop-nav-link]') ?? []);
	const activeDesktopNavLink = desktopNavLinks.find((link) => link.getAttribute('aria-current') === 'page');
	const desktopMedia = window.matchMedia('(min-width: 64rem)');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	let closeTimer: number | undefined;
	let restoreFocusOnClose = true;

	const moveDesktopSignal = (link?: HTMLAnchorElement) => {
		if (!desktopNav || !link) return;

		const navRect = desktopNav.getBoundingClientRect();
		const linkRect = link.getBoundingClientRect();
		const railInset = Math.min(14, linkRect.width * 0.18);
		desktopNav.style.setProperty('--signal-x', `${linkRect.left - navRect.left + railInset}px`);
		desktopNav.style.setProperty('--signal-width', `${Math.max(18, linkRect.width - railInset * 2)}px`);
		desktopNav.classList.add('is-signal-ready');
	};

	const restoreDesktopSignal = () => moveDesktopSignal(activeDesktopNavLink);

	desktopNavLinks.forEach((link) => {
		link.addEventListener('pointerenter', () => moveDesktopSignal(link));
		link.addEventListener('focus', () => moveDesktopSignal(link));
	});

	desktopNav?.addEventListener('pointerleave', restoreDesktopSignal);
	desktopNav?.addEventListener('focusout', (event) => {
		if (!desktopNav.contains(event.relatedTarget as Node | null)) restoreDesktopSignal();
	});

	if (desktopNav && activeDesktopNavLink) {
		requestAnimationFrame(restoreDesktopSignal);
		new ResizeObserver(restoreDesktopSignal).observe(desktopNav);
		document.fonts?.ready.then(restoreDesktopSignal);
	}

	const finishClose = () => {
		if (!menu?.open) return;
		menu.close();
	};

	const closeMenu = (restoreFocus = true, immediate = false) => {
		if (!menu?.open) return;

		restoreFocusOnClose = restoreFocus;
		window.clearTimeout(closeTimer);
		if (immediate || reducedMotion.matches) {
			finishClose();
		} else {
			menu.classList.add('is-closing');
			closeTimer = window.setTimeout(finishClose, 240);
		}
	};

	openButton?.addEventListener('click', () => {
		if (!menu) return;
		menu.showModal();
		openButton.setAttribute('aria-expanded', 'true');
		document.documentElement.classList.add('mobile-menu-open');
		closeButton?.focus();
	});

	closeButton?.addEventListener('click', () => closeMenu());

	menu?.addEventListener('cancel', (event) => {
		event.preventDefault();
		closeMenu();
	});

	menu?.addEventListener('close', () => {
		window.clearTimeout(closeTimer);
		menu.classList.remove('is-closing');
		openButton?.setAttribute('aria-expanded', 'false');
		document.documentElement.classList.remove('mobile-menu-open');
		if (restoreFocusOnClose) openButton?.focus();
		restoreFocusOnClose = true;
	});

	menuLinks?.forEach((link) => link.addEventListener('click', () => closeMenu(false, true)));
	desktopMedia.addEventListener('change', (event) => {
		if (event.matches) closeMenu(false, true);
	});
</script>

<style>
	:global(html.mobile-menu-open) {
		overflow: hidden;
	}

	dialog::backdrop {
		background: #001e45;
	}

	.radar-rings {
		background:
			radial-gradient(circle, transparent 0 31%, rgb(255 255 255 / 8%) 31.2% 31.45%, transparent 31.7% 49%),
			radial-gradient(circle, transparent 0 61%, rgb(69 160 243 / 12%) 61.2% 61.45%, transparent 61.7%);
	}

	.desktop-signal-rail {
		bottom: 0.3rem;
		left: 0;
		height: 1px;
		width: var(--signal-width, 0);
		transform: translateX(var(--signal-x, 0));
		background: rgb(69 160 243 / 82%);
		opacity: 0;
		transition:
			width 280ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
			opacity 180ms ease;
	}

	.desktop-nav.is-signal-ready .desktop-signal-rail {
		opacity: 1;
	}

	.desktop-signal-point {
		box-shadow: 0 0 0 3px rgb(69 160 243 / 12%);
	}

	dialog[open] {
		animation: menu-shell-in 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	dialog[open] .mobile-menu-background {
		animation: menu-background-in 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	dialog[open] .mobile-menu-link {
		animation: menu-link-in 460ms cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: calc(90ms + var(--item-index) * 45ms);
	}

	dialog.is-closing {
		animation: menu-shell-out 240ms ease-in both;
	}

	@keyframes menu-shell-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes menu-background-in {
		from {
			opacity: 0;
			transform: scale(1.04);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	@keyframes menu-link-in {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes menu-shell-out {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}
</style>
