---
import { localize } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';
import { featuresIntro, features } from '../../data/radar4flood';
import SectionHeading from './SectionHeading.astro';
import ImageSlot from './ImageSlot.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
---

<section class="relative py-24 sm:py-32" id="r4f-features">
	<div class="mx-auto max-w-[94rem] px-5 sm:px-8 2xl:max-w-[102rem]">
		<SectionHeading
			lang={lang}
			chapter="02"
			kicker={featuresIntro.kicker}
			title={featuresIntro.title}
			body={featuresIntro.body}
		/>

		<ol class="mt-20 flex flex-col gap-20 sm:gap-24">
			{
				features.map((feature, i) => (
					<li
						class:list={[
							'grid items-center gap-8 lg:grid-cols-2 lg:gap-14',
							feature.id === 'mobile-alert' && 'lg:grid-cols-[1.25fr_0.75fr]',
						]}
						id={`r4f-feature-${feature.id}`}
					>
						<div class:list={['relative', i % 2 === 1 && 'lg:order-2']} data-reveal>
							<span
								class="r4f-chapter pointer-events-none absolute -top-9 -left-1 !text-[clamp(3.5rem,7vw,5.5rem)]"
								aria-hidden="true"
							>
								{feature.index}
							</span>
							<div class="relative pt-10">
								<p class="text-xs font-bold tracking-[0.16em] text-r4f-sky uppercase">{feature.tagline}</p>
								<h3 class="mt-3 font-display text-[clamp(1.5rem,3vw,2.25rem)] font-semibold leading-snug text-white">
									{localize(feature.title, lang)}
								</h3>
								<p class="mt-4 max-w-xl text-[0.95rem] leading-8 text-sky-100/76">
									{localize(feature.description, lang)}
								</p>
								<ul class="mt-6 flex max-w-xl flex-wrap gap-2">
									{feature.capabilities.map((cap) => (
										<li class="rounded-full bg-white/7 px-3.5 py-1.5 text-[0.8rem] font-semibold text-sky-50/88">
											{cap}
										</li>
									))}
								</ul>
							</div>
						</div>

						<div
							class:list={[
								i % 2 === 1 && 'lg:order-1',
								feature.id === 'mobile-alert' && 'mx-auto w-full max-w-[18rem] lg:max-w-[20rem]',
							]}
							data-reveal
							style="--reveal-i: 1;"
						>
							<ImageSlot lang={lang} note={feature.imageNote} ratio={feature.imageRatio} />
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
