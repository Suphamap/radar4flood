---
import { localize } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';
import { stationDataIntro, stationDataProducts } from '../../data/radar4flood';
import SectionHeading from './SectionHeading.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
---

<section class="relative py-24 sm:py-32" id="r4f-station-data">
	<div class="mx-auto max-w-[94rem] px-5 sm:px-8 2xl:max-w-[102rem]">
		<SectionHeading
			lang={lang}
			chapter="03"
			kicker={stationDataIntro.kicker}
			title={stationDataIntro.title}
			body={stationDataIntro.body}
		/>

		<ul class="mt-14 grid gap-5 md:grid-cols-3">
			{
				stationDataProducts.map((product, i) => (
					<li
						class="flex flex-col rounded-2xl bg-white/5 p-7 transition duration-300 hover:bg-white/8"
						data-reveal
						style={`--reveal-i: ${i};`}
					>
						<p class="inline-flex self-start rounded-full bg-r4f-sky/15 px-3.5 py-1.5 text-[0.8rem] font-bold text-sky-200">
							{product.meta}
						</p>
						<h3 class="mt-5 font-display text-xl font-semibold text-white sm:text-2xl">
							{localize(product.title, lang)}
						</h3>
						<p class="mt-3 text-[0.95rem] leading-8 text-sky-100/74">{localize(product.description, lang)}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
