---
import { localize, t } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';
import { heroContent, heroCadence, serviceBasins } from '../../data/radar4flood';

interface Props {
	lang: Lang;
	forecastUrl: string;
}

const { lang, forecastUrl } = Astro.props;

// deterministic pseudo-random rain layout so SSR output is stable
const rainDrops = Array.from({ length: 14 }, (_, i) => ({
	left: `${(i * 61.8) % 100}%`,
	delay: `${((i * 0.47) % 2.8).toFixed(2)}s`,
	duration: `${(2.2 + ((i * 0.31) % 1.4)).toFixed(2)}s`,
}));

const blips = [
	{ top: '30%', left: '62%', delay: '0.8s' },
	{ top: '57%', left: '71%', delay: '2.4s' },
	{ top: '66%', left: '38%', delay: '4.1s' },
	{ top: '38%', left: '30%', delay: '5.6s' },
];

/**
 * Cadence stats pinned onto the scope rings as radar readings.
 * `ping` syncs each dot's pulse with the sweep beam: the beam's bright edge
 * points at 0° (top) at t = 0 and rotates clockwise once every 7s, so a dot
 * at clockwise angle θ pulses at θ/360 × 7s into each rotation.
 */
const callouts = heroCadence.map((stat, i) => ({
	...stat,
	...[
		{ top: '7%', left: '46%', enter: '1.15s', ping: '6.90s' },
		{ top: '47%', left: '66%', enter: '1.65s', ping: '1.54s' },
		{ top: '76%', left: '8%', enter: '2.15s', ping: '4.63s' },
	][i],
}));

// degree tick marks around the outer ring
const ticks = Array.from({ length: 24 }, (_, i) => i * 15);
---

<section class="relative isolate overflow-clip">
	<div class="r4f-grid-texture absolute inset-0" aria-hidden="true"></div>

	<!-- rain field -->
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		{
			rainDrops.map((drop) => (
				<span
					class="r4f-rain"
					style={`left:${drop.left}; --rain-delay:${drop.delay}; --rain-duration:${drop.duration};`}
				/>
			))
		}
	</div>

	<div
		class="relative mx-auto grid min-h-[calc(100svh-4.75rem)] max-w-[94rem] grid-rows-[1fr_auto] px-5 sm:px-8 2xl:max-w-[102rem]"
	>
		<!-- main zone: copy left, radar scope right -->
		<div class="grid items-center gap-10 py-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] lg:gap-4 lg:py-6">
			<div class="max-w-2xl">
				<p class="r4f-kicker hero-rise" style="--d: 0.15s;">{localize(heroContent.kicker, lang)}</p>

				<h1 class="mt-5 font-display text-[clamp(2.9rem,6.4vw,5.9rem)] font-semibold leading-[1.05] text-white">
					<span class="hero-line" style="--d: 0.3s;">{localize(heroContent.titleLead, lang)}</span><br />
					<span class="hero-line text-r4f-sky" style="--d: 0.48s;">{localize(heroContent.titleAccent, lang)}</span>
				</h1>

				<p class="hero-rise mt-6 max-w-xl text-base leading-8 text-sky-100/80 sm:text-lg sm:leading-9" style="--d: 0.65s;">
					{localize(heroContent.support, lang)}
				</p>

				<div class="hero-rise mt-8 flex flex-wrap gap-3" style="--d: 0.8s;">
					<a
						class="cta-primary inline-flex min-h-12 items-center gap-2 rounded-full bg-r4f-teal px-7 py-3 text-[0.95rem] font-bold text-white transition hover:bg-[#0d7b81] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
						href={forecastUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						{t(lang, 'r4fOpenForecast')}
						<svg
							class="cta-arrow h-4 w-4"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							aria-hidden="true"
						>
							<path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"></path>
						</svg>
					</a>
					<a
						class="inline-flex min-h-12 items-center rounded-full bg-white/10 px-7 py-3 text-[0.95rem] font-bold text-white transition hover:bg-white/18 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
						href="#r4f-features"
					>
						{t(lang, 'r4fExploreFeatures')}
					</a>
				</div>

				<!-- cadence stats: slim inline row on mobile/tablet only -->
				<dl class="hero-rise mt-10 grid grid-cols-3 divide-x divide-white/10 lg:hidden" style="--d: 0.95s;">
					{
						heroCadence.map((stat, i) => (
							<div class:list={['pr-4', i > 0 && 'pl-4']}>
								<dd class="font-display text-2xl font-semibold text-white sm:text-3xl">
									{stat.value}
									<span class="ml-1 text-sm font-medium text-sky-200/85">{localize(stat.unit, lang)}</span>
								</dd>
								<dt class="mt-1 text-xs leading-5 text-sky-100/65 sm:text-sm">{localize(stat.label, lang)}</dt>
							</div>
						))
					}
				</dl>
			</div>

			<!-- radar scope: the protagonist -->
			<div
				class="hero-drift relative hidden aspect-square w-[min(42vw,74svh)] max-w-full justify-self-center lg:block xl:justify-self-end"
				aria-hidden="true"
			>
				<div class="hero-scope absolute inset-0">
					<svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 100">
						{
							[15, 27.5, 40].map((r) => (
								<circle cx="50" cy="50" r={r} fill="none" stroke="rgb(143 196 247 / 0.18)" stroke-width="0.18" />
							))
						}
						<circle cx="50" cy="50" r="47" fill="none" stroke="rgb(143 196 247 / 0.3)" stroke-width="0.22"></circle>
						{
							ticks.map((deg) => (
								<line
									x1="50"
									y1="3"
									x2="50"
									y2={deg % 45 === 0 ? '5.4' : '4.4'}
									stroke="rgb(143 196 247 / 0.4)"
									stroke-width="0.22"
									transform={`rotate(${deg} 50 50)`}
								/>
							))
						}
						<line x1="3" y1="50" x2="97" y2="50" stroke="rgb(143 196 247 / 0.09)" stroke-width="0.18"></line>
						<line x1="50" y1="3" x2="50" y2="97" stroke="rgb(143 196 247 / 0.09)" stroke-width="0.18"></line>
						<circle cx="50" cy="50" r="1" fill="rgb(143 228 255 / 0.9)"></circle>
					</svg>

					<div class="absolute inset-[3%]">
						<div class="r4f-sweep hero-sweep"></div>
					</div>

					{
						blips.map((blip) => (
							<span class="r4f-blip" style={`top:${blip.top}; left:${blip.left}; --blip-delay:${blip.delay};`} />
						))
					}

					<!-- cadence stats as radar readings, detected as the beam passes -->
					{
						callouts.map((stat) => (
							<div
								class="hero-callout absolute flex items-center"
								style={`top:${stat.top}; left:${stat.left}; --d:${stat.enter}; --ping:${stat.ping};`}
							>
								<span class="callout-dot" />
								<span class="callout-line" />
								<div class="rounded-xl bg-[#001737]/82 px-4 py-2.5 ring-1 ring-sky-300/20 backdrop-blur">
									<p class="font-display text-2xl font-semibold leading-tight text-white xl:text-[1.7rem]">
										{stat.value}
										<span class="ml-1 text-sm font-medium text-sky-200/85">{localize(stat.unit, lang)}</span>
									</p>
									<p class="mt-0.5 text-xs leading-5 whitespace-nowrap text-sky-100/65">{localize(stat.label, lang)}</p>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>

		<!-- pinned bottom strip -->
		<div class="hero-fade flex flex-wrap items-center justify-between gap-x-8 gap-y-4 border-t border-white/8 py-5" style="--d: 1.1s;">
			<ul class="flex flex-wrap gap-2.5">
				{
					serviceBasins.map((basin) => (
						<li class="inline-flex items-center gap-2 rounded-full bg-white/7 px-4 py-2 text-sm font-semibold text-sky-50/92">
							<span class="h-1.5 w-1.5 rounded-full bg-r4f-sky" aria-hidden="true" />
							{localize(basin, lang)}
						</li>
					))
				}
			</ul>
			<div class="r4f-scroll-cue flex items-center gap-3 text-sm font-semibold text-sky-200/60" aria-hidden="true">
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M12 5v14m0 0 5-5m-5 5-5-5" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
				{t(lang, 'r4fScrollCue')}
			</div>
		</div>
	</div>
</section>

<style>
	/* ---- entrance choreography (pure CSS, runs without JS) ---- */
	.hero-rise {
		animation: hero-rise-in 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: var(--d, 0s);
	}

	@keyframes hero-rise-in {
		from {
			opacity: 0;
			transform: translateY(22px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.hero-fade {
		animation: hero-fade-in 0.9s ease-out both;
		animation-delay: var(--d, 0s);
	}

	@keyframes hero-fade-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	/* headline resolves out of blur like a signal sharpening */
	.hero-line {
		display: inline-block;
		animation: hero-line-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: var(--d, 0s);
	}

	@keyframes hero-line-in {
		from {
			opacity: 0;
			transform: translateY(0.3em);
			filter: blur(12px);
		}
		to {
			opacity: 1;
			transform: none;
			filter: blur(0);
		}
	}

	/* scope calibrates: settles from a slight counter-rotation */
	.hero-scope {
		animation: hero-calibrate 1.15s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	@keyframes hero-calibrate {
		from {
			opacity: 0;
			transform: rotate(-9deg) scale(0.94);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	/* sweep beam powers on after the scope settles, rotation keeps global timing */
	.hero-sweep {
		animation:
			r4f-sweep-rotate 7s linear infinite,
			hero-fade-in 0.9s ease-out 0.45s both;
	}

	/* ---- stat callouts: detected by the beam ---- */
	.hero-callout {
		filter: drop-shadow(0 10px 24px rgb(0 10 28 / 45%));
		animation: hero-callout-pop 0.65s cubic-bezier(0.3, 1.45, 0.45, 1) both;
		animation-delay: var(--d, 1.2s);
	}

	@keyframes hero-callout-pop {
		from {
			opacity: 0;
			transform: translate(-8px, 12px) scale(0.82);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.callout-dot {
		position: relative;
		width: 0.5rem;
		height: 0.5rem;
		flex-shrink: 0;
		border-radius: 9999px;
		background: #8fe4ff;
		box-shadow: 0 0 12px rgb(143 228 255 / 70%);
	}

	/* expanding ring pulse, in phase with the sweep beam passing the dot */
	.callout-dot::after {
		content: '';
		position: absolute;
		inset: -3px;
		border-radius: 9999px;
		border: 1px solid rgb(143 228 255 / 80%);
		opacity: 0;
		animation: callout-ping 7s linear infinite;
		animation-delay: var(--ping, 0s);
	}

	@keyframes callout-ping {
		0% {
			opacity: 0.9;
			transform: scale(0.4);
		}
		11% {
			opacity: 0;
			transform: scale(3.2);
		}
		100% {
			opacity: 0;
			transform: scale(3.2);
		}
	}

	.callout-line {
		width: 1.5rem;
		height: 1px;
		flex-shrink: 0;
		background: linear-gradient(90deg, rgb(143 228 255 / 70%), rgb(143 228 255 / 15%));
	}

	/* ---- micro-interaction: primary CTA arrow nudge ---- */
	.cta-arrow {
		transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.cta-primary:hover .cta-arrow {
		transform: translate(2px, -2px);
	}

	/* ---- scroll parallax: scope lags behind as the hero exits ---- */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.hero-drift {
				animation: hero-drift-out linear both;
				animation-duration: auto;
				animation-timeline: view();
				animation-range: exit 0% exit 100%;
			}
		}
	}

	@keyframes hero-drift-out {
		to {
			opacity: 0.2;
			transform: translateY(76px);
		}
	}
</style>
