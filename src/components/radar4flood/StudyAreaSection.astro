---
import { localize } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';
import {
	studyAreaIntro,
	studyAreaStats,
	monitoringNetwork,
	telemetryStations,
	telemetryStationsTitle,
} from '../../data/radar4flood';
import SectionHeading from './SectionHeading.astro';
import ImageSlot from './ImageSlot.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
---

<section class="relative py-24 sm:py-32" id="r4f-study-area">
	<div class="mx-auto max-w-[94rem] px-5 sm:px-8 2xl:max-w-[102rem]">
		<SectionHeading
			lang={lang}
			chapter="04"
			kicker={studyAreaIntro.kicker}
			title={studyAreaIntro.title}
			body={studyAreaIntro.body}
		/>

		<!-- animated counters -->
		<dl class="mt-14 grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-white/8 lg:grid-cols-4" data-reveal>
			{
				studyAreaStats.map((stat) => (
					<div class="bg-[#001737]/72 px-6 py-7 sm:px-8">
						<dd class="font-display text-[clamp(1.75rem,3.4vw,2.75rem)] font-semibold text-white">
							<span data-count={stat.value} data-decimals={stat.decimals ?? 0}>
								{stat.value.toLocaleString('th-TH', {
									minimumFractionDigits: stat.decimals ?? 0,
									maximumFractionDigits: stat.decimals ?? 0,
								})}
							</span>
							<span class="ml-1.5 text-base font-medium text-sky-200/85">{localize(stat.unit, lang)}</span>
						</dd>
						<dt class="mt-2 text-sm leading-6 text-sky-100/68">{localize(stat.label, lang)}</dt>
					</div>
				))
			}
		</dl>

		<div class="mt-16 grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
			<div data-reveal>
				<ImageSlot lang={lang} note={studyAreaIntro.imageNote} ratio="4 / 5" class="lg:sticky lg:top-24" />
			</div>

			<div class="flex flex-col gap-5">
				{
					monitoringNetwork.map((item, i) => (
						<article class="rounded-2xl bg-white/5 p-7 sm:p-8" data-reveal style={`--reveal-i: ${i};`}>
							<div class="flex flex-wrap items-baseline justify-between gap-3">
								<h3 class="font-display text-xl font-semibold text-white">{localize(item.title, lang)}</h3>
								<p class="text-sm font-bold text-r4f-sky">{item.stat}</p>
							</div>
							<p class="mt-3 text-[0.95rem] leading-8 text-sky-100/74">{localize(item.body, lang)}</p>
						</article>
					))
				}

				<div class="rounded-2xl bg-white/5 p-7 sm:p-8" data-reveal style="--reveal-i: 3;">
					<h3 class="font-display text-xl font-semibold text-white">{localize(telemetryStationsTitle, lang)}</h3>
					<ul class="mt-5 flex flex-col gap-3">
						{
							telemetryStations.map((station) => (
								<li class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[0.95rem]">
									<span class="inline-flex w-24 justify-center rounded-full bg-r4f-sky/15 px-3 py-1 text-[0.8rem] font-bold text-sky-200">
										{station.code}
									</span>
									<span class="font-medium text-sky-50/92">{localize(station.name, lang)}</span>
									<span class="text-sm text-sky-200/55">{localize(station.basin, lang)}</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</div>
</section>
