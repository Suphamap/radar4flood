---
import { routeHref, t } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';
import type { NewsCategory } from '../../types/content';

interface BrowseItem {
	label: string;
	value: NewsCategory;
}

interface Props {
	lang?: Lang;
	browseItems: BrowseItem[];
}

const { lang = 'th', browseItems } = Astro.props;
const archiveHref = routeHref(lang, 'news');
---

<section class="news-hero relative isolate overflow-hidden bg-r4f-navy text-white">
	<div
		class="mx-auto grid min-h-[28rem] max-w-[94rem] gap-10 px-5 pb-10 pt-14 sm:px-8 md:pb-12 md:pt-20 lg:grid-cols-[minmax(0,1fr)_minmax(21rem,0.86fr)] lg:items-end 2xl:max-w-[102rem]"
	>
		<div class="relative z-10 max-w-3xl">
			<h1 class="font-display text-[clamp(2.9rem,7vw,5.75rem)] font-semibold leading-[1.04] tracking-normal">
				{t(lang, 'newsArchiveTitle')}
			</h1>
			<p class="mt-5 max-w-2xl text-base leading-8 text-white/82 sm:text-lg sm:leading-9">
				{t(lang, 'newsArchiveIntro')}
			</p>

			<form class="mt-8 max-w-2xl" role="search" method="get" action={archiveHref} data-news-search-form>
				<label class="text-sm font-bold text-white" for="news-search">{t(lang, 'newsArchiveSearchLabel')}</label>
				<div class="mt-3 flex flex-col gap-3 rounded-2xl bg-white p-2 sm:flex-row sm:items-center">
					<div class="flex min-h-12 flex-1 items-center gap-3 px-3 text-r4f-ink">
						<svg class="h-5 w-5 shrink-0 text-r4f-teal" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path
								d="m21 21-4.3-4.3m1.55-5.45a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
						<input
							id="news-search"
							class="min-h-12 w-full bg-transparent text-base font-medium text-r4f-ink outline-none placeholder:text-[#52677E]"
							type="search"
							name="q"
							autocomplete="off"
							placeholder={t(lang, 'newsArchiveSearchPlaceholder')}
							data-news-search
						/>
					</div>
					<button
						class="inline-flex min-h-12 items-center justify-center rounded-xl bg-r4f-sky px-6 text-sm font-bold text-white transition hover:bg-[#277fd0] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
						type="submit"
					>
						{t(lang, 'newsArchiveSearchButton')}
					</button>
				</div>
			</form>
		</div>

		<div class="relative z-10 lg:pb-4">
			<p class="text-base font-bold text-white">{t(lang, 'newsArchiveBrowseLabel')}</p>
			<div class="mt-5 flex flex-wrap gap-x-6 gap-y-3" aria-label={t(lang, 'newsArchiveBrowseLabel')}>
				<a
					class="browse-filter text-left text-sm font-bold text-sky-100 transition hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-r4f-sky"
					href={archiveHref}
					data-news-filter="all"
					data-news-filter-label={t(lang, 'newsArchiveAll')}
					aria-pressed="true"
				>
					{t(lang, 'newsArchiveAll')}
					<span aria-hidden="true">›</span>
				</a>
				{
					browseItems.map((item) => (
						<a
							class="browse-filter text-left text-sm font-bold text-sky-100 transition hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-r4f-sky"
							href={`${archiveHref}?category=${encodeURIComponent(item.value)}`}
							data-news-filter={item.value}
							data-news-filter-label={item.label}
							aria-pressed="false"
						>
							{item.label}
							<span aria-hidden="true">›</span>
						</a>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.news-hero {
		background-image:
			linear-gradient(90deg, rgb(0 17 44 / 88%) 0%, rgb(0 30 69 / 72%) 46%, rgb(0 30 69 / 44%) 100%),
			url('/radar4flood-hero-background.svg');
		background-position: center top;
		background-repeat: no-repeat;
		background-size: cover;
	}

	.news-hero::before {
		position: absolute;
		inset: auto -12% -32% 44%;
		height: 25rem;
		content: '';
		background: radial-gradient(circle, rgb(69 160 243 / 20%) 0%, rgb(69 160 243 / 0%) 66%);
		pointer-events: none;
	}

	.browse-filter[aria-pressed='true'] {
		color: white;
		text-decoration: underline;
		text-decoration-color: var(--color-r4f-sky);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.55rem;
	}
</style>
