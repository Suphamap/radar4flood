---
import { alternateRoutePath, routePath, t } from '../lib/i18n';
import type { Lang } from '../lib/i18n';

interface Props {
	lang?: Lang;
}

const { lang = 'th' } = Astro.props;

const langSwitchHref = alternateRoutePath(lang, Astro.url.pathname);
---

<footer class="bg-r4f-navy text-white">
	<div class="mx-auto grid max-w-[94rem] gap-8 px-5 py-10 sm:px-8 md:grid-cols-[1fr_auto] md:items-center 2xl:max-w-[102rem]">
		<div>
			<p class="font-display text-2xl font-semibold">Radar4Flood</p>
			<p class="mt-2 max-w-2xl text-sm leading-7 text-white/68">
				{t(lang, 'footerTagline')}
			</p>
		</div>
		<div class="flex flex-wrap gap-3 text-sm font-semibold text-white/76">
			<a class="hover:text-white" href={routePath(lang, '/staff')}>{t(lang, 'navStaff')}</a>
			<a class="hover:text-white" href={routePath(lang, '/contact')}>{t(lang, 'navContact')}</a>
			<a class="hover:text-white" href={langSwitchHref}>
				{lang === 'en' ? 'ภาษาไทย' : 'English'}
			</a>
		</div>
	</div>
</footer>
